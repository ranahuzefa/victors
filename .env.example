# Required paths
INPUT_DIR=./input
OUTPUT_DIR=./output

# Export format: SVG, PDF, EPS, DXF, or PNG
OUTPUT_FORMAT=SVG

# Browser execution
MAX_CONCURRENT=1
MAX_SAFE_CONCURRENT=1
HEADLESS=true
BROWSER_CHANNEL=chromium
BROWSER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/146.0.7680.178 Safari/537.36
PROFILE_AUTO_IP_MATCH=false
PROFILE_LOCALE=en-US
PROFILE_LANGUAGES=en-US,en
PROFILE_TIMEZONE=America/New_York
PROFILE_GEO_LATITUDE=40.7128
PROFILE_GEO_LONGITUDE=-74.0060
PROFILE_GEO_ACCURACY=25000
PROFILE_IP_GEO_URL=http://ip-api.com/json/?fields=status,message,countryCode,lat,lon,timezone,query
PROFILE_IP_GEO_TIMEOUT_SECONDS=2
PROFILE_IP_GEO_CACHE_SECONDS=21600

# Optional headless credential login
AUTO_LOGIN=true
MANUAL_LOGIN_FALLBACK=true
AUTO_REFRESH_PROFILE_ON_ACCOUNT_REDIRECT=true
VECTORIZER_EMAIL=you@example.com
VECTORIZER_PASSWORD=your-password

# Timeouts
CONVERSION_TIMEOUT_MS=300000
DOWNLOAD_TIMEOUT_MS=120000
DOM_CALL_TIMEOUT_MS=15000

# Retry and stuck-job detection
STALL_WARN_SECONDS=30
STALL_TIMEOUT_SECONDS=90
MAX_RETRIES=2
RETRY_DELAY_SECONDS=5
RETRY_JITTER_SECONDS=2

# Service-friendly pacing and cooldowns
MIN_REQUEST_INTERVAL_SECONDS=8
RATE_LIMIT_COOLDOWN_SECONDS=300
SERVICE_BLOCK_COOLDOWN_SECONDS=900

# Optional notifications
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# TELEGRAM_BOT_TOKEN=123456:token
# TELEGRAM_CHAT_ID=123456
